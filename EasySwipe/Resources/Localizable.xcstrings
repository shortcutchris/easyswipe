    "settings.dark" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dunkel" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Dark" } } } },
    "settings.interface.hint" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Änderungen gelten sofort für Swindoo. Datums- und Zahlenformate folgen weiterhin deiner Systemregion." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes apply immediately to Swindoo. Dates and numbers still follow your system region." } } } },
    "settings.behavior" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Verhalten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Behavior" } } } },
    "settings.help" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Sprache und Darstellung werden für diese App gespeichert. Die Gestaltung anderer Apps bleibt unverändert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Language and appearance are saved for this app. Other apps keep their own appearance." } } } },
    "updates.version" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Version & Status" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Version & Status" } } } },
    "updates.availableVersion" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Verfügbare Version" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Available version" } } } },
    "updates.lastCheck" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuletzt erfolgreich geprüft" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Last successful check" } } } },
    "updates.automatic" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Automatische Updates" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic Updates" } } } },
    "updates.autoCheck" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch nach Updates suchen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically check for updates" } } } },
    "updates.autoDownload" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Updates automatisch herunterladen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically download updates" } } } },
    "updates.safety" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Signierte Updates werden von Sparkle geprüft und installiert. Eine laufende Fenstergeste wird vor dem Neustart abgeschlossen. Download und Installation steuerst du im Updatefenster." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Sparkle verifies and installs signed updates. An active window gesture finishes before restarting. Manage the download and installation in the update window." } } } },
    "updates.languageHint" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Sparkle-Dialog und macOS-Systemdialoge folgen der macOS-App-Sprache; sie können von der hier gewählten Sprache abweichen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The Sparkle dialog and macOS system dialogs follow the macOS app language and may differ from your selection here." } } } },
    "updates.status.unChecked" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Noch nicht geprüft" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Not checked yet" } } } },
    "updates.status.unconfigured" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein gültiger Updatekanal eingerichtet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No valid update channel configured." } } } },
    "updates.status.checking" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Updates werden geprüft …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking for updates…" } } } },
    "updates.status.current" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Du verwendest die aktuelle Version." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "You’re up to date." } } } },
    "updates.status.noCompatibleUpdate" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein passendes Update für diese Installation verfügbar." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No compatible update available for this installation." } } } },
    "updates.status.available" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine neue Version ist verfügbar." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "A new version is available." } } } },
    "updates.status.downloading" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Update wird heruntergeladen …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading update…" } } } },
