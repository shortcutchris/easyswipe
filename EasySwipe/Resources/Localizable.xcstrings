    "onboarding.deviceHint" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verwende zwei Finger auf einem Trackpad oder wische über die Touch-Oberfläche deiner Magic Mouse." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use two fingers on a trackpad, or swipe on the touch surface of your Magic Mouse." } }
      }
    },
    "onboarding.finish" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Einrichtung abschließen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish Setup" } }
      }
    },
    "onboarding.subtitle" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ordne Fenster direkt über ihre Titelbar an." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Arrange windows directly from their title bars." } }
      }
    },
    "onboarding.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Willkommen bei Swindoo" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Swindoo" } }
      }
    },
    "permission.explanation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Swindoo verwendet Bedienungshilfen, um das Fenster unter dem Mauszeiger zu erkennen und anzuordnen. Fensterinhalte werden nie gelesen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Swindoo uses Accessibility to identify and arrange the window below your pointer. It never reads window contents." } }
      }
    },
    "permission.granted" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Berechtigung erteilt" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission granted" } }
      }
    },
    "permission.missing" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Berechtigung erforderlich" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission required" } }
      }
    },
    "permission.openSettings" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Systemeinstellungen öffnen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } }
      }
    },
    "permission.request" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Berechtigung erteilen…" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Grant Permission…" } }
      }
    },
    "permission.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bedienungshilfen-Berechtigung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility Permission" } }
      }
    },
    "update.unavailable.message" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Entwicklungsbuild hat keinen signierten Update-Feed. Release-Builds können mit einem Sparkle-Appcast und öffentlichem Schlüssel konfiguriert werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This development build has no signed update feed. Release builds can be configured with a Sparkle appcast and public key." } }
      }
    },
    "update.unavailable.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Updates nicht konfiguriert" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates Not Configured" } }
      }
    }
