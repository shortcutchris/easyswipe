    "updates.status.waiting" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Installation wartet auf die laufende Fenstergeste." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Installation is waiting for the current window gesture." } } } },
    "updates.status.installing" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Update wird installiert …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Installing update…" } } } },
    "updates.status.cancelled" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Download abgebrochen. Du kannst erneut nach Updates suchen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Download cancelled. You can check for updates again." } } } },
    "updates.status.failed" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Update fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut. Details stehen im Updatefenster." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Update failed. Check your connection and try again. See the update window for details." } } } },
