      }
    },
    "login.error.title" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Anmeldeeinstellung konnte nicht geändert werden" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could Not Change Login Setting" } }
      }
    },
    "login.requiresApproval" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erlaube Swindoo unter Systemeinstellungen > Allgemein > Anmeldeobjekte, um den Start beim Anmelden zu aktivieren." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Swindoo in System Settings > General > Login Items to finish enabling launch at login." } }
