    "login.error.message" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Anmeldeoption konnte nicht geändert werden. Prüfe Systemeinstellungen → Allgemein → Anmeldeobjekte und versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"The login setting could not be changed. Check System Settings → General → Login Items and try again."}}}},
    "updates.failure.network" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Update-Server ist nicht erreichbar. Prüfe deine Verbindung und suche erneut nach Updates."}},"en":{"stringUnit":{"state":"translated","value":"The update server could not be reached. Check your connection and try again."}}}},
    "updates.failure.general" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Update konnte nicht geprüft oder sicher installiert werden. Deine aktuelle Version bleibt erhalten. Weitere Informationen stehen im Update-Fenster; du kannst erneut suchen."}},"en":{"stringUnit":{"state":"translated","value":"The update could not be checked or safely installed. Your current version is preserved. See the update window for details, or check again."}}}},
