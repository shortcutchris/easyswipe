    "gesture.up" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach oben wischen, um zu maximieren" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Swipe up to maximize" } }
      }
    },
    "guide.footer" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bewege den Mauszeiger über eine Fenstertitelbar, wische und hebe dann die Finger an." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Place the pointer over a window title bar, swipe, then lift your fingers." } }
      }
    },
